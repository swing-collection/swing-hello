#: forms/form_hello.py
msgid "Language"
msgstr "언어"

#: forms/form_hello.py
msgid "Choose the language for your greeting."
msgstr "인사말 언어를 선택하세요."

#: forms/form_hello.py
msgid "Formal"
msgstr "격식체"

#: forms/form_hello.py
msgid "Casual"
msgstr "비격식체"

#: forms/form_hello.py
msgid "Enthusiastic"
msgstr "열정적"

