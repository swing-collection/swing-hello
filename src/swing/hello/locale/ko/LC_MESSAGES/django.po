#: views/view_hello_form.py models.py forms/form_hello.py
msgid "Hello, {name}!"
msgstr "안녕하세요, {name}님!"

#: views/view_hello_json.py
msgid "Hello, World!"
msgstr "안녕하세요, 세계!"

#: models.py forms/form_hello.py
msgid "Good day, {name}. It is a pleasure to meet you."
msgstr "{name}님, 안녕하십니까. 만나서 반갑습니다."

#: models.py forms/form_hello.py
msgid "Hey {name}! So excited to see you!"
msgstr "야 {name}! 만나서 너무 좋아!"

#: models.py
msgid "Name"
msgstr "이름"

