#: forms/form_hello.py
msgid "Your Name"
msgstr "이름"

#: forms/form_hello.py
msgid "Enter your name"
msgstr "이름을 입력하세요"

#: forms/form_hello.py
msgid "Please enter your full name."
msgstr "전체 이름을 입력해 주세요."

#: forms/form_hello.py
msgid "Name cannot be empty or only whitespace."
msgstr "이름은 비어 있거나 공백만 포함할 수 없습니다."

#: forms/form_hello.py
msgid "Name should contain only letters and spaces."
msgstr "이름은 문자와 공백만 포함해야 합니다."

#: forms/form_hello.py
msgid "Greeting Style"
msgstr "인사 스타일"

